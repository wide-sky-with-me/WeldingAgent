# pWPS Agent environment template.
# Copy this file to .env and fill in provider credentials before running live LLM or web-search flows.
# Do not commit .env with real secrets.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------

# Required for LLM-backed tools and the LLM Supervisor.
# Use an API key from any OpenAI-compatible provider.
LLM_API_KEY=

# Required for LLM-backed tools.
# Example for OpenAI-compatible providers: https://api.example.com/v1
LLM_BASE_URL=

# Required for LLM-backed tools.
# Example: deepseek-chat, gpt-4.1-mini, or another OpenAI-compatible model id.
LLM_MODEL=

# Optional. Lower values make extraction/planning more reproducible.
LLM_TEMPERATURE=0.2

# Optional request timeout in seconds for LLM calls.
LLM_TIMEOUT_SECONDS=120

# Structured-output method used by LangChain ChatOpenAI.with_structured_output.
# Allowed: function_calling, json_mode, json_schema
LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# Provider-specific thinking-mode hint.
# Allowed: empty, enabled, disabled
# DeepSeek V4 structured output is usually safer with disabled.
LLM_THINKING_TYPE=disabled

# Compatibility aliases.
# Provider-neutral LLM_* values take precedence when both are set.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Knowledge source strategy
# -----------------------------------------------------------------------------

# Comma-separated enabled knowledge sources in priority order.
# local_doc: search configured local markdown/text references first.
# web: use the configured web-search provider as the next evidence source.
# model: allow LLM intrinsic-knowledge fallback only when external evidence is missing.
# Example without a local knowledge base: web,model
KNOWLEDGE_SOURCES=local_doc,web

# Web search provider
# -----------------------------------------------------------------------------

# Select the live search provider.
# Allowed current values: tavily, brave
WEB_SEARCH_PROVIDER=tavily

# Maximum results requested per web query.
WEB_SEARCH_MAX_RESULTS=5

# Per-provider request timeout in seconds.
WEB_SEARCH_TIMEOUT_SECONDS=30

# Retry count for transient web-search failures.
WEB_SEARCH_MAX_RETRIES=2

# Backoff between transient web-search retries in seconds.
WEB_SEARCH_RETRY_BACKOFF_SECONDS=0.5

# Cache duplicate web-search queries in the provider instance.
# Accepted truthy values: 1, true, yes, on
WEB_SEARCH_CACHE_ENABLED=true

# Tavily settings. Required when WEB_SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=

# Allowed: basic, advanced
TAVILY_SEARCH_DEPTH=basic

# Whether Tavily should include raw page content.
TAVILY_INCLUDE_RAW_CONTENT=false

# Brave settings. Required when WEB_SEARCH_PROVIDER=brave.
BRAVE_SEARCH_API_KEY=

# Brave market controls.
BRAVE_SEARCH_COUNTRY=us
BRAVE_SEARCH_LANG=en
BRAVE_SEARCH_SAFETY=moderate

# -----------------------------------------------------------------------------
# Local document retrieval
# -----------------------------------------------------------------------------

# Directory containing local .md, .markdown, and .txt reference documents.
PWPS_LOCAL_DOCS_DIR=data/local_docs

# Maximum local document snippets returned per local-doc query.
LOCAL_DOC_MAX_RESULTS=5

# Maximum characters kept in each local document snippet.
LOCAL_DOC_SNIPPET_CHARS=420

# -----------------------------------------------------------------------------
# Runtime output paths
# -----------------------------------------------------------------------------

# Default output root for run artifacts.
PWPS_OUTPUT_DIR=data/outputs

# Reserved trace path setting for future/legacy trace organization.
PWPS_TRACE_DIR=data/outputs/traces
